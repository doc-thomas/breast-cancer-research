def get_metrics(y_true, y_prob, threshold=0.5):
    y_pred = (y_prob >= threshold).astype(int)
    auc = roc_auc_score(y_true, y_prob)
    acc = accuracy_score(y_true, y_pred)
    brier = brier_score_loss(y_true, y_prob)
    tn, fp, fn, tp = confusion_matrix(y_true, y_pred).ravel()
    sens = tp / (tp + fn) if (tp + fn) > 0 else 0
    spec = tn / (tn + fp) if (tn + fp) > 0 else 0
    ppv = tp / (tp + fp) if (tp + fp) > 0 else 0
    npv = tn / (tn + fn) if (tn + fn) > 0 else 0
    f1 = 2 * (ppv * sens) / (ppv + sens) if (ppv + sens) > 0 else 0
    return auc, acc, sens, spec, ppv, npv, f1, brier

def bootstrap_auc_ci(y_true, y_prob, n_bootstraps=1000, rng_seed=42):
    bootstrapped_scores = []
    rng = np.random.RandomState(rng_seed)
    for i in range(n_bootstraps):
        indices = rng.randint(0, len(y_prob), len(y_prob))
        if len(np.unique(y_true[indices])) < 2: continue
        bootstrapped_scores.append(roc_auc_score(y_true[indices], y_prob[indices]))
    sorted_scores = np.sort(np.array(bootstrapped_scores))
    return sorted_scores[int(0.025 * len(sorted_scores))], sorted_scores[int(0.975 * len(sorted_scores))]

def calculate_nri_idi(y_true, p_old, p_new):
    event = (y_true == 1)
    nonevent = (y_true == 0)
    idi_event = np.mean(p_new[event]) - np.mean(p_old[event])
    idi_nonevent = np.mean(p_old[nonevent]) - np.mean(p_new[nonevent])
    idi = idi_event + idi_nonevent
    nri_event = (np.sum(p_new[event] > p_old[event]) - np.sum(p_new[event] < p_old[event])) / np.sum(event)
    nri_nonevent = (np.sum(p_old[nonevent] > p_new[nonevent]) - np.sum(p_old[nonevent] < p_new[nonevent])) / np.sum(nonevent)
    nri = nri_event + nri_nonevent
    return nri, idi

def preprocess_multimodal_data(df_clin, df_scores, features, target='label', train_center='A'):
    def map_stage(stage):
        if pd.isna(stage): return np.nan
        s = str(stage).lower().strip()
        mapping = {'i': 1, 'ia': 1, 'ib': 2, 'ii': 3, 'iia': 3, 'iib': 4, 
                   'iii': 5, 'iiia': 5, 'iiib': 6, 'iiic': 7, 'iv': 8}
        return mapping.get(s, np.nan)
    if 'Clin_Stage' in df_clin.columns:
        df_clin['Clin_Stage'] = df_clin['Clin_Stage'].apply(map_stage)
    df_clin['PatientID'] = df_clin['PatientID'].astype(str).str.strip()
    df_scores['PatientID'] = df_scores['PatientID'].astype(str).str.strip()
    df_master = pd.merge(df_clin, df_scores.drop(columns=[target, 'Center'], errors='ignore'), 
                         on='PatientID', how='inner')
    train_mask = df_master['Center'].str.contains(train_center)
    for col in features:
        df_master[col] = pd.to_numeric(df_master[col], errors='coerce')
        median_val = df_master.loc[train_mask, col].median()
        df_master[col] = df_master[col].fillna(median_val)
    return df_master

def run_vif_diagnosis(df, features):
    X = df[features].dropna()
    X = add_constant(X)
    vif_data = pd.DataFrame()
    vif_data["Feature"] = X.columns
    vif_data["VIF"] = [variance_inflation_factor(X.values, i) for i in range(X.shape[1])]
    return vif_data[vif_data["Feature"] != "const"].sort_values("VIF", ascending=False)

def run_elastic_net_selection(X, y):
    model = LogisticRegressionCV(
        Cs=100, cv=10, penalty='elasticnet', solver='saga',
        l1_ratios=[0.1, 0.5, 0.7, 0.9, 0.95, 0.99, 1.0],
        max_iter=5000, class_weight='balanced', random_state=2026, n_jobs=-1
    )
    model.fit(X, y)
    coefs = pd.Series(model.coef_[0], index=X.columns)
    selected_features = coefs[coefs != 0].index.tolist()
    return selected_features, coefs

def plot_multicenter_roc(roc_data, centers, output_path):
    fig, axes = plt.subplots(2, 2, figsize=(16, 14))
    axes = axes.flatten()
    for idx, center in enumerate(centers):
        ax = axes[idx]
        center_df = [d for d in roc_data if d['Center'] == center]
        for d in sorted(center_df, key=lambda x: x['AUC'], reverse=True):
            fpr_unique, unique_idx = np.unique(d['FPR'], return_index=True)
            tpr_unique = d['TPR'][unique_idx]
            mean_fpr = np.linspace(0, 1, 300)
            tpr_smooth = np.interp(mean_fpr, fpr_unique, tpr_unique)
            ax.plot(mean_fpr, tpr_smooth, lw=2.5, label=f"{d['Label']} (AUC: {d['AUC']:.3f})")
        ax.plot([0, 1], [0, 1], linestyle=':', color='gray')
        ax.set_title(center)
        ax.legend(loc="lower right")
    plt.tight_layout()
    plt.savefig(output_path, dpi=600)

